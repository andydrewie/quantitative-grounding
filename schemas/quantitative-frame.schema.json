{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andydrewie/quantitative-grounding/blob/main/schemas/quantitative-frame.schema.json",
  "title": "QG-01 Quantitative Frame",
  "description": "Optional structured summary of the quantitative anchors that materially shape an analytical conclusion.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["metric", "value_or_range", "meaning", "basis_or_confidence"],
        "additionalProperties": false,
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "value_or_range": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "basis_or_confidence": {"type": "string", "minLength": 1},
          "as_of": {"type": "string"},
          "epistemic_status": {
            "type": "string",
            "enum": [
              "verified_fact",
              "reported_data",
              "calculated_result",
              "informed_estimate",
              "scenario_assumption",
              "speculative_judgment"
            ]
          }
        }
      }
    }
  }
}
